# Copy to /etc/knowledgeos/knowledgeos.env on the guest (mode 600).
# Do not commit a filled copy.

PORT=8080
KNOWLEDGEOS_DB=/var/lib/knowledgeos/data/knowledgeos.db
KNOWLEDGEOS_WEB=/usr/local/share/knowledgeos/web
KNOWLEDGEOS_WORKERS=0
KNOWLEDGEOS_TASK_CHUNK=32

# Optional. Dashboard and deterministic insights work without this.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
